# Port the app listens on (devpush should route to this same port)
PORT=8000

# Google account(s) used to serve authBundles, one per line.
# Format: email aas_token
# Get an AAS/master token via gpsoauth (see get_aas_token.py) or the
# whyorean/Authenticator app. Treat this like a password — do not commit
# it to git or share it.
ACCOUNTS_TXT=you@gmail.com aas_et/REPLACE_WITH_REAL_TOKEN
