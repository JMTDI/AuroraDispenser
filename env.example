# Port the app listens on (devpush should route to this same port)
PORT=8000

# Google account(s) used to serve authBundles.
# Format: email token, one account per line.
# Get an AAS/master token via gpsoauth (see get_aas_token.py) or the
# whyorean/Authenticator app. Treat this like a password — do not commit
# it to git or share it.
#
# If your env var UI supports multi-line values, paste multiple lines directly:
# ACCOUNTS_TXT=you@gmail.com aas_et/TOKEN_ONE
# second@gmail.com aas_et/TOKEN_TWO
#
# If it only supports single-line values, use literal \n between accounts:
ACCOUNTS_TXT=you@gmail.com aas_et/REPLACE_WITH_REAL_TOKEN\nsecond@gmail.com aas_et/REPLACE_WITH_REAL_TOKEN
